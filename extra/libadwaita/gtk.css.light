/* Ayu (light) libadwaita named-color overrides
 *
 * Install via extra/libadwaita/install.sh
 * libadwaita loads ~/.config/gtk-4.0/gtk.css on top of its own styles,
 * so re-defining these named colors re-skins modern GNOME GTK4 apps.
 */
@define-color accent_bg_color #F29718;
@define-color accent_fg_color #7E4B01;
@define-color accent_color #F29718;
@define-color accent_color_rgba rgba(242, 151, 24, 1);

@define-color destructive_bg_color #E65050;
@define-color destructive_fg_color #FFFFFF;
@define-color destructive_color #E65050;

@define-color success_bg_color #6CBF43;
@define-color success_fg_color #FFFFFF;
@define-color success_color #6CBF43;

@define-color warning_bg_color #EBA400;
@define-color warning_fg_color #5C6166;
@define-color warning_color #EBA400;

@define-color error_bg_color #E65050;
@define-color error_fg_color #FFFFFF;
@define-color error_color #E65050;

/*scrol window / views */
@define-color window_bg_color #F8F9FA;
@define-color window_fg_color #5C6166;
@define-color view_bg_color #FCFCFC;
@define-color view_fg_color #5C6166;

/* header bar */
@define-color headerbar_bg_color #F8F9FA;
@define-color headerbar_fg_color #5C6166;
@define-color headerbar_border_color rgba(107, 125, 143, 0.12);
@define-color headerbar_backdrop_color #FFFFFF;
@define-color headerbar_shade_color rgba(0, 0, 0, 0.12);
@define-color headerbar_darker_shade_color rgba(0, 0, 0, 0.25);

@define-color sidebar_bg_color #FAFAFA;
@define-color sidebar_fg_color #5C6166;
@define-color sidebar_backdrop_color #F8F9FA;
@define-color sidebar_shade_color rgba(0, 0, 0, 0.12);

@define-color secondary_sidebar_bg_color #FAFAFA;
@define-color secondary_sidebar_fg_color #5C6166;
@define-color secondary_sidebar_backdrop_color #F8F9FA;
@define-color secondary_sidebar_shade_color rgba(0, 0, 0, 0.12);

@define-color card_bg_color #FCFCFC;
@define-color card_fg_color #5C6166;
@define-color popover_bg_color #FFFFFF;
@define-color popover_fg_color #5C6166;

@define-color thumbnail_fg_color #FCFCFC;

@define-color dialog_bg_color #F8F9FA;
@define-color dialog_fg_color #5C6166;

@define-color bluebench_border_color rgba(107, 125, 143, 0.12);
@define-color unfocused_borders rgba(107, 125, 143, 0.12);

@define-color unfocused_fg_color #828E9F;
